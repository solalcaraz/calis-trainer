---
import type { Pregunta } from '../lib/tipos';

interface Props {
  preguntas: Pregunta[];
}
const { preguntas } = Astro.props;

const datosFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---

{
  preguntas.length > 0 && (
    <section id="preguntas" class="seccion" aria-labelledby="titulo-preguntas">
      <div class="contenedor preguntas-contenedor">
        <div class="seccion__cabecera">
          <p class="label">Preguntas frecuentes</p>
          <h2 class="display-l" id="titulo-preguntas">Antes de arrancar</h2>
        </div>
        <div class="preguntas">
          {preguntas.map((p) => (
            <details class="pregunta">
              <summary class="h3">{p.pregunta}</summary>
              <p>{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(datosFaq)} />
    </section>
  )
}

<style>
  .preguntas-contenedor { max-width: 860px; }
  .preguntas { border-top: 1px solid var(--linea); }
  .pregunta { border-bottom: 1px solid var(--linea); }
  .pregunta summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: var(--space-6) 0; cursor: pointer; list-style: none; color: var(--tinta);
  }
  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary::after {
    content: '+'; flex-shrink: 0; font-family: var(--font-display); font-size: 28px; line-height: 1; color: var(--granate-texto);
  }
  .pregunta[open] summary::after { content: '–'; }
  @media (hover: hover) { .pregunta summary:hover { color: var(--granate-texto); } }
  .pregunta p { padding-bottom: var(--space-6); max-width: 62ch; }
</style>
